TELEGRAM_BOT_TOKEN=

# openai atau deepseek
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-5.4-mini

# Opsional. Default OpenAI: https://api.openai.com/v1
# Default DeepSeek: https://api.deepseek.com
AI_BASE_URL=

# API key tambahan untuk credential profile Module. Nama variable harus sama
# dengan field "Nama environment variable" pada Admin > Modules.
# AI_KEY_MARKETING=
# AI_KEY_FINANCE=

DATABASE_PATH=data/bot.db
USERS_FILE=config/users.json
COMPANIES_FILE=config/companies.json
ROLE_PROFILES_FILE=config/role_profiles.json
PROJECT_ROOT=.
HISTORY_LIMIT=12
MAX_CONCURRENT_UPDATES=4
KNOWLEDGE_MAX_CHARS=50000
MAX_RESPONSE_CHARS=12000
LOG_LEVEL=INFO

# Admin web. Ketiganya wajib diisi bersama untuk mengaktifkan dashboard.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=true
ADMIN_PORT=8080
